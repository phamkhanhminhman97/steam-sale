{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steam-sale",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "steam-sale.phamkhanhminhman.com", "custom_domain": true}],
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "404-page"},
  "d1_databases": [{"binding": "DB", "database_name": "steam-sale", "database_id": "27fff239-5552-4659-8730-a91d422698c1", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "DATA", "bucket_name": "steam-sale-data"}],
  "workflows": [{"name": "steam-sale-sync", "binding": "SYNC", "class_name": "SyncDeals"}],
  "triggers": {"crons": ["7 * * * *"]},
  "vars": {"SYNC_ENABLED": "true"},
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "traces": {"enabled": true, "head_sampling_rate": 0.1}}
}
